{
  "name": "react-pyodide",
  "version": "1.1.0",
  "description": "High-performance client-side Python runner in React using Pyodide, WebAssembly (WASM), and Web Workers.",
  "main": "index.js",
  "homepage": "https://main-react-pyodide.devyun09.workers.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevDAN09/react-pyodide.git"
  },
  "keywords": [
    "react",
    "pyodide",
    "webassembly",
    "wasm",
    "python",
    "cpython",
    "web-worker",
    "client-side",
    "cloudflare-workers"
  ],
  "author": "DevDAN09",
  "license": "MIT",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest",
    "dev": "vite",
    "prebuild": "mkdir -p public/pyodide && cp node_modules/pyodide/pyodide.asm.mjs node_modules/pyodide/pyodide.asm.wasm node_modules/pyodide/pyodide-lock.json node_modules/pyodide/python_stdlib.zip public/pyodide/",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:ci": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "pyodide": "^314.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
